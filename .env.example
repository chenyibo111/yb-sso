# Copy to .env and fill with the credentials of your Feishu enterprise custom app.
# Multica's local Hydra client is registered by scripts/register-clients.ps1.
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_TENANT_KEY=your_tenant_key
FEISHU_REDIRECT_URI=http://localhost:9000/auth/feishu/callback
SSO_DATABASE_URL=postgres://hydra:local-development-only-password@127.0.0.1:5433/hydra?sslmode=disable
SSO_SERVICE_KEY=replace-with-the-same-32-character-random-key-as-reimbursement
# Host-run defaults need no extra settings. Compose supplies internal URLs and bind address.
# HYDRA_ISSUER=http://localhost:4444/
# HYDRA_ADMIN_URL=http://localhost:4445
# HYDRA_JWKS_URL=
# SSO_BIND_ADDRESS=127.0.0.1:9000
